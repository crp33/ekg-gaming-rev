# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express server listens on locally. Railway sets its own PORT env var in production.
PORT=3000

# Anthropic Claude API key, used by server/modules/claude.js
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase project URL and keys, used by server/modules/supabase.js and
# public/auth.js. Found in your Supabase project settings under API.
# Leave all three blank to run without login/storage (see server/modules/supabase.js) —
# the upload -> extract -> export flow works either way.
SUPABASE_URL=
# "anon public" key — safe to expose to the browser (protected by Row Level
# Security, see supabase/schema.sql). Used by public/auth.js for login.
SUPABASE_ANON_KEY=
# "service_role secret" key — NEVER expose this to the browser. Used only
# server-side to verify user sessions and write extracted data, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=
