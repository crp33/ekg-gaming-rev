# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express server listens on locally. Railway sets its own PORT env var in production.
PORT=3000

# Anthropic Claude API key, used by server/modules/claude.js
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase project URL and API key, used by server/modules/supabase.js
# Found in your Supabase project settings under API
SUPABASE_URL=
SUPABASE_KEY=
